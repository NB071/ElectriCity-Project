# Express variables
LOCAL_ADDRESS=0.0.0.0
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=electricity
MYSQL_USER=electricity_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_PORT=3306

# DB variables
DB_HOST=127.0.0.1
DB_LOCAL_DBNAME=electricity
DB_LOCAL_USER=electricity_user
DB_LOCAL_PASSWORD=change_me_db_password

# Redis variables
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Email variables
EMAIL_HOST=smtp.xyz.com
EMAIL_PORT=587
EMAIL_USER=********@xyz.com
EMAIL_PASS=********
EMAIL_FROM=********@xyz.com
SMTP_SECURE=false

# Gemini variables
GEMINI_API_KEY=********
GEMINI_MODEL=gemini-3.1-flash-lite

# Sentry variables
SENTRY_ENABLED=false
SENTRY_DSN=https://********@o********.ingest.us.sentry.io/********
SENTRY_DEV_TRACES_SAMPLE_RATE=1.0
SENTRY_DEV_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_PROD_TRACES_SAMPLE_RATE=0.1
SENTRY_PROD_PROFILE_SESSION_SAMPLE_RATE=0.1

# Other variables
JWT_SIGN_KEY=********
BACKEND_UPSTREAM=http://backend:8080