# Express variables
LOCAL_ADDRESS=0.0.0.0
PORT=5000
NODE_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=electricity
MYSQL_USER=electricity_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_PORT=3306

# DB variables
DB_HOST=127.0.0.1
DB_LOCAL_DBNAME=electricity
DB_LOCAL_USER=electricity_user
DB_LOCAL_PASSWORD=change_me_db_password

# Redis variables
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Email variables
EMAIL_HOST=your_email_host
EMAIL_PORT=your_email_port
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass
EMAIL_FROM=your_email_from
SMTP_SECURE=false

# Other variables
JWT_SIGN_KEY=your_jwt_sign_key

# Gemini AI (chatbot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_TOOL_ROUNDS=5
GEMINI_MAX_TOOL_RESULT_CHARS=12000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=1500
