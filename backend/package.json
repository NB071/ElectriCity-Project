{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "start": "nodemon --legacy-watch --import ./configs/sentry.js index.js",
        "db:schema:apply": "node models/apply-schema.js",
        "db:seed:apply": "node models/apply-seed.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --coverage",
        "test:tc": "npm run test",
        "test:tc:fresh": "npm run db:seed:apply && npm run test:coverage",
        "docker:up": "docker compose -f ../docker/docker-compose.yml --env-file .env up -d --build",
        "docker:down": "docker compose -f ../docker/docker-compose.yml --env-file .env down",
        "docker:logs": "docker compose -f ../docker/docker-compose.yml --env-file .env logs -f",
        "docker:npm-ci": "docker exec electricity-backend npm ci"
    },
    "keywords": [],
    "author": "G",
    "license": "ISC",
    "type": "module",
    "description": "Backend for Electricity E-Commerce Platform",
    "dependencies": {
        "@google/genai": "^2.11.0",
        "@sentry/node": "^10.65.0",
        "@sentry/profiling-node": "^10.65.0",
        "axios": "^1.16.1",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.78.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.22.4",
        "nodemailer": "^9.0.1",
        "nodemon": "^3.1.14",
        "stripe": "^22.2.1",
        "ua-parser-js": "^2.0.10",
        "uuid": "^14.0.0",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "jest": "^29.7.0"
    }
}
