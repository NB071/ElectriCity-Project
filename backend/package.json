{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "start": "nodemon --legacy-watch index.js",
        "db:schema:apply": "node models/apply-schema.js",
        "db:seed:apply": "node models/apply-seed.js",
        "test:email": "node tests/email-service/email-service.test.js",
        "test:media": "node tests/media-service/media-service.test.js",
        "test:iam:access": "node tests/iam-service/access-auth.test.js",
        "test:analytics:event": "node tests/analytics-service/generate-event.test.js",
        "test:analytics:report": "node tests/analytics-service/generate-report.test.js",
        "test:catalog:browse": "node tests/catalog-service/browse-vehicles.test.js",
        "test:catalog:search": "node tests/catalog-service/search-vehicles.test.js",
        "test:catalog:details": "node tests/catalog-service/catalog-details.test.js",
        "test:catalog:compare": "node tests/catalog-service/catalog-compare.test.js",
        "test:catalog": "node tests/catalog-service/browse-vehicles.test.js && node tests/catalog-service/search-vehicles.test.js && node tests/catalog-service/catalog-details.test.js && node tests/catalog-service/catalog-compare.test.js",
        "docker:up": "docker compose -f ../docker/docker-compose.yml --env-file .env up -d --build",
        "docker:down": "docker compose -f ../docker/docker-compose.yml --env-file .env down",
        "docker:logs": "docker compose -f ../docker/docker-compose.yml --env-file .env logs -f"
    },
