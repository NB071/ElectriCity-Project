        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "mysql2": "^3.22.4",
        "nodemailer": "^9.0.1",
        "nodemon": "^3.1.14",
