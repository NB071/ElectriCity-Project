{
    "name": "frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "author": "EECS 4413 Group G",
    "license": "ISC",
    "description": "Frontend for Electricity E-Commerce Platform",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:up": "docker compose -f ../docker/docker-compose.yml --env-file ../backend/.env up -d --build",
        "docker:down": "docker compose -f ../docker/docker-compose.yml --env-file ../backend/.env down",
        "docker:logs": "docker compose -f ../docker/docker-compose.yml --env-file ../backend/.env logs -f",
        "docker:npm-ci": "docker exec electricity-frontend npm ci"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.2.9",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/react-query": "^5.100.14",
        "@tanstack/react-query-devtools": "^5.100.14",
        "@tanstack/react-router": "^1.170.10",
        "@tanstack/react-table": "^8.21.3",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "crypto-js": "^4.2.0",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "formik": "^2.4.9",
        "framer-motion": "^12.42.2",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.17.0",
        "motion": "^12.42.2",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.4.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-icons": "^5.7.0",
        "react-leaflet": "^5.0.0",
        "react-use-measure": "^2.1.7",
        "recharts": "^3.8.0",
        "shadcn": "^3.8.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "uuid": "^14.0.1",
        "zod": "^4.4.3",
        "zod-formik-adapter": "^2.0.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
